FROM python:3.10-slim

WORKDIR /app

# Install ffmpeg and build tools
RUN apt-get update && apt-get install -y ffmpeg build-essential

COPY requirements.txt .

# Increase timeout to prevent "Read timed out" errors
RUN pip install --no-cache-dir --default-timeout=1000 --retries 5 -r requirements.txt

COPY . .

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]