{
  "name": "require-asset",
  "version": "1.2.4",
  "description": "Import assets across JavaScript runtimes",
  "exports": {
    "./package": "./package.json",
    ".": {
      "bare": "./lib/bare.js",
      "node": "./lib/node.js",
      "default": "./lib/default.js"
    }
  },
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "url": {
      "bare": "bare-url",
      "default": "url"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:bare && npm run test:node",
    "test:bare": "brittle-bare --coverage test.js",
    "test:node": "brittle-node --coverage test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/require-asset.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/require-asset/issues"
  },
  "homepage": "https://github.com/holepunchto/require-asset#readme",
  "engines": {
    "bare": ">=1.10.0",
    "node": ">=18"
  },
  "dependencies": {
    "bare-module-resolve": "^1.6.2"
  },
  "devDependencies": {
    "bare-bundle": "^1.8.1",
    "bare-bundle-evaluate": "^1.1.0",
    "bare-fs": "^4.0.0",
    "bare-path": "^3.0.0",
    "bare-url": "^2.1.0",
    "brittle": "^3.7.0",
    "lunte": "^1.8.0",
    "prettier": "^3.4.1",
    "prettier-config-holepunch": "^2.0.0"
  }
}
